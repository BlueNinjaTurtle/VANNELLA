# 8️⃣ Exemple simple de code

---

# Code Arduino UNO

```cpp
int boutonOccupe = 10;
int boutonLibre = 11;
int idSalle = 1;  // Défini par salle

void setup(){

Serial.begin(115200);

pinMode(boutonOccupe, INPUT_PULLUP);
pinMode(boutonLibre, INPUT_PULLUP);

}

void loop(){

if(digitalRead(boutonOccupe)==LOW){

  Serial.print("SALLE=");
  Serial.print(idSalle);
  Serial.print(";ETAT=occupee\n");
  
  delay(500);  // Debounce
}

if(digitalRead(boutonLibre)==LOW){

  Serial.print("SALLE=");
  Serial.print(idSalle);
  Serial.print(";ETAT=libre\n");
  
  delay(500);  // Debounce
}

}
```

---

# Code serveur (PHP)

```php
<?php

$data = json_decode(file_get_contents("php://input"));

$id = $data->id_salle;
$etat = $data->etat;

$conn = new mysqli("localhost","root","","gestion_salles");

$sql = "UPDATE etat_salles 
        SET etat='$etat' 
        WHERE id_salle=$id";

$conn->query($sql);

echo "OK";

?>
```

---

# Exemple requête API

```
POST /api/updateSalle
```

Body :

```
{
"id_salle":2,
"etat":"occupee"
}
```

