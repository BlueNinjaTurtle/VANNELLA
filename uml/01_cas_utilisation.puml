@startuml
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "Administrateur" as Admin
actor "Utilisateur / Etudiant" as User
actor "Capteur IoT" as IOT
actor "Systeme" as System

rectangle "Systeme de gestion intelligente des salles" {
  usecase "S'authentifier" as UC_Login
  usecase "Gerer les salles" as UC_Salles
  usecase "Gerer les departements" as UC_Depts
  usecase "Gerer les promotions" as UC_Promos
  usecase "Gerer les cours" as UC_Cours
  usecase "Lancer l'attribution optimale" as UC_Optimize
  usecase "Enregistrer un horaire" as UC_AddHoraire
  usecase "Annuler / reactiver un horaire" as UC_StatusHoraire
  usecase "Detecter les cours d'ensemble" as UC_Ensemble
  usecase "Simuler ou forcer l'etat d'une salle" as UC_ForceEtat
  usecase "Consulter les salles en temps reel" as UC_ViewSalles
  usecase "Consulter le planning hebdomadaire" as UC_ViewPlanning
  usecase "Consulter l'historique des etats" as UC_History
  usecase "Envoyer l'etat d'occupation" as UC_IOTUpdate
  usecase "Mettre a jour l'etat de salle" as UC_UpdateEtat
  usecase "Tracer l'historique" as UC_Trace
}

Admin --> UC_Login
Admin --> UC_Salles
Admin --> UC_Depts
Admin --> UC_Promos
Admin --> UC_Cours
Admin --> UC_Optimize
Admin --> UC_AddHoraire
Admin --> UC_StatusHoraire
Admin --> UC_Ensemble
Admin --> UC_ForceEtat
Admin --> UC_ViewPlanning
Admin --> UC_History

User --> UC_ViewSalles
User --> UC_ViewPlanning

IOT --> UC_IOTUpdate
System --> UC_UpdateEtat
System --> UC_Trace

UC_Optimize ..> UC_AddHoraire : <<include>>
UC_AddHoraire ..> UC_UpdateEtat : <<include>>
UC_AddHoraire ..> UC_Trace : <<include>>
UC_ForceEtat ..> UC_UpdateEtat : <<include>>
UC_ForceEtat ..> UC_Trace : <<include>>
UC_IOTUpdate ..> UC_UpdateEtat : <<include>>
UC_UpdateEtat ..> UC_Trace : <<include>>
UC_Ensemble ..> UC_StatusHoraire : <<extend>>
@enduml
