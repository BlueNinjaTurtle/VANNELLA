@startuml
skinparam classAttributeIconSize 0

class Admin {
  +id_admin: int
  +username: string
  +password: string
  +nom_complet: string
}

class Departement {
  +id_departement: int
  +nom_departement: string
}

class Promotion {
  +id_promotion: int
  +nom_promotion: string
  +filiere: string
  +niveau: string
  +effectif: int
}

class Cours {
  +id_cours: int
  +nom_cours: string
  +enseignant: string
}

class Salle {
  +id_salle: int
  +nom_salle: string
  +capacite: int
  +batiment: string
}

class Horaire {
  +id_horaire: int
  +jour: string
  +heure_debut: time
  +heure_fin: time
  +statut: StatutHoraire
  +type_cours: TypeCours
}

class EtatSalle {
  +id: int
  +etat: Etat
  +date_update: datetime
  +modified_by: SourceModification
  +modified_at: datetime
}

class EtatSalleHistory {
  +id: int
  +etat_ancien: Etat
  +etat_nouveau: Etat
  +modified_by: SourceModification
  +raison: string
  +timestamp: datetime
}

enum Etat {
  libre
  occupee
  reservee
  indisponible
}

enum StatutHoraire {
  actif
  annule
}

enum TypeCours {
  specifique
  ensemble
}

enum SourceModification {
  IoT
  Admin
  Planning
  System
}

class OptimisationService {
  +promotionPriority(promotion): int
  +isPromotionEnsemble(promotion): bool
  +chercherSalleOptimale(promotion, jour, debut, fin): Salle
}

class PlanningService {
  +ajouterHoraire(horaire): void
  +annulerConflits(horaire): int
  +mettreAJourStatutHoraire(id, statut): void
  +detecterCoursEnsemble(): int
}

class EtatSalleService {
  +mettreAJourEtat(salle, etat, source): void
  +forcerEtat(salle, etat, raison): void
  +enregistrerHistorique(salle, ancien, nouveau): void
}

Departement "1" o-- "0..*" Promotion
Departement "1" o-- "0..*" Cours
Promotion "1" -- "0..*" Horaire
Cours "1" -- "0..*" Horaire
Salle "1" -- "0..*" Horaire
Salle "1" -- "0..1" EtatSalle
Salle "1" -- "0..*" EtatSalleHistory

Horaire --> StatutHoraire
Horaire --> TypeCours
EtatSalle --> Etat
EtatSalle --> SourceModification
EtatSalleHistory --> Etat
EtatSalleHistory --> SourceModification

OptimisationService ..> Salle
OptimisationService ..> Promotion
OptimisationService ..> Horaire
PlanningService ..> Horaire
PlanningService ..> EtatSalleService
EtatSalleService ..> EtatSalle
EtatSalleService ..> EtatSalleHistory
@enduml
