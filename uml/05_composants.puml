@startuml
skinparam componentStyle rectangle

actor "Administrateur" as Admin
actor "Utilisateur" as User
actor "Capteur IoT / Simulation" as IOT

component "Interface publique\nindex.php" as PublicUI
component "Vue salles\nsalles_view.php + js/salles_view.js" as SallesView
component "Vue planning\nplanning_view.php" as PlanningView
component "Administration\nadmin.php + sections/* + js/*" as AdminUI
component "Simulation IoT\nsimulation-iot.php" as SimUI
component "Tableau SCADA\njs/iot_scada.js" as ScadaUI

component "API Salles\ngetSalles, addSalle,\nupdateSalle, deleteSalle" as ApiSalles
component "API Planning\noptimize, addHoraire,\ngetHorairesByWeek" as ApiPlanning
component "API Etat\nupdate_etat_salle,\nforceEtat, iot_update" as ApiEtat
component "API Referentiels\ncours, promotions,\ndepartements" as ApiRefs
component "API Historique\ngetEtatHistory" as ApiHistory

database "Base MySQL\ngestion_salles" as DB
component "Arduino / Capteurs PIR" as Arduino
component "Bridge Python IoT\nScript_python.py" as Bridge

Admin --> AdminUI
Admin --> SimUI
User --> PublicUI
User --> SallesView
User --> PlanningView
IOT --> Arduino
Arduino --> Bridge
Bridge --> ApiEtat

PublicUI --> ApiSalles
SallesView --> ApiSalles
SallesView --> ApiPlanning
SallesView --> ApiRefs
PlanningView --> ApiPlanning
AdminUI --> ApiSalles
AdminUI --> ApiPlanning
AdminUI --> ApiRefs
AdminUI --> ApiHistory
SimUI --> ApiSalles
SimUI --> ApiEtat
ScadaUI --> ApiSalles
ScadaUI --> ApiHistory

ApiSalles --> DB
ApiPlanning --> DB
ApiEtat --> DB
ApiRefs --> DB
ApiHistory --> DB
@enduml
