@startuml
node "Poste utilisateur\nNavigateur web" as Browser {
  artifact "Pages HTML/PHP rendues"
  artifact "JavaScript AJAX"
}

node "Serveur local XAMPP" as Server {
  node "Apache + PHP" as Apache {
    artifact "index.php"
    artifact "admin.php"
    artifact "simulation-iot.php"
    artifact "api/*.php"
  }
  database "MariaDB / MySQL\ngestion_salles" as MySQL
}

node "Dispositif IoT" as Device {
  artifact "Arduino"
  artifact "Capteur de presence"
}

node "Bridge IoT" as Bridge {
  artifact "Script_python.py"
}

Browser --> Apache : HTTP/AJAX
Apache --> MySQL : PDO/MySQL
Device --> Bridge : Serial/USB
Bridge --> Apache : HTTP GET/POST\napi/iot_update.php
@enduml
