@startuml
actor "Administrateur" as Admin
participant "Simulation IoT\nsimulation-iot.php" as UI
participant "API Etat\napi/update_etat_salle.php" as API
database "Base MySQL" as DB

Admin -> UI : Choisir une salle
Admin -> UI : Cliquer "LIBRE"
UI -> API : POST id_salle, etat='libre',\nid_horaire/periode
API -> DB : Verifier la salle
API -> DB : Lire l'etat actuel
API -> DB : UPDATE/INSERT etat_salles = libre
alt Horaire cible fourni
  API -> DB : Verifier horaire actif cible
  API -> DB : UPDATE horaires SET statut='annule'
else Periode choisie
  API -> DB : Chercher horaires actifs du jour\navant-midi ou apres-midi
  API -> DB : UPDATE horaires SET statut='annule'
end
API -> DB : INSERT etat_salles_history
API --> UI : JSON succes + horaires_annules
UI -> UI : Recharger les salles
UI --> Admin : Notification de succes
@enduml
