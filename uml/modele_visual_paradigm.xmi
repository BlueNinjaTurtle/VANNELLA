<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.1"
  xmlns:xmi="http://schema.omg.org/spec/XMI/2.1"
  xmlns:uml="http://www.eclipse.org/uml2/3.0.0/UML">
  <uml:Model xmi:id="model_vannella" name="GestionIntelligenteSalles">
    <packagedElement xmi:type="uml:Package" xmi:id="pkg_domain" name="Domaine">
      <packagedElement xmi:type="uml:Class" xmi:id="class_admin" name="Admin">
        <ownedAttribute xmi:id="admin_id" name="id_admin"/>
        <ownedAttribute xmi:id="admin_username" name="username"/>
        <ownedAttribute xmi:id="admin_password" name="password"/>
        <ownedAttribute xmi:id="admin_nom" name="nom_complet"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="class_departement" name="Departement">
        <ownedAttribute xmi:id="dept_id" name="id_departement"/>
        <ownedAttribute xmi:id="dept_nom" name="nom_departement"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="class_promotion" name="Promotion">
        <ownedAttribute xmi:id="promo_id" name="id_promotion"/>
        <ownedAttribute xmi:id="promo_nom" name="nom_promotion"/>
        <ownedAttribute xmi:id="promo_filiere" name="filiere"/>
        <ownedAttribute xmi:id="promo_niveau" name="niveau"/>
        <ownedAttribute xmi:id="promo_effectif" name="effectif"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="class_cours" name="Cours">
        <ownedAttribute xmi:id="cours_id" name="id_cours"/>
        <ownedAttribute xmi:id="cours_nom" name="nom_cours"/>
        <ownedAttribute xmi:id="cours_enseignant" name="enseignant"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="class_salle" name="Salle">
        <ownedAttribute xmi:id="salle_id" name="id_salle"/>
        <ownedAttribute xmi:id="salle_nom" name="nom_salle"/>
        <ownedAttribute xmi:id="salle_capacite" name="capacite"/>
        <ownedAttribute xmi:id="salle_batiment" name="batiment"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="class_horaire" name="Horaire">
        <ownedAttribute xmi:id="horaire_id" name="id_horaire"/>
        <ownedAttribute xmi:id="horaire_jour" name="jour"/>
        <ownedAttribute xmi:id="horaire_debut" name="heure_debut"/>
        <ownedAttribute xmi:id="horaire_fin" name="heure_fin"/>
        <ownedAttribute xmi:id="horaire_statut" name="statut"/>
        <ownedAttribute xmi:id="horaire_type" name="type_cours"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="class_etat" name="EtatSalle">
        <ownedAttribute xmi:id="etat_id" name="id"/>
        <ownedAttribute xmi:id="etat_valeur" name="etat"/>
        <ownedAttribute xmi:id="etat_date" name="date_update"/>
        <ownedAttribute xmi:id="etat_source" name="modified_by"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="class_history" name="EtatSalleHistory">
        <ownedAttribute xmi:id="hist_id" name="id"/>
        <ownedAttribute xmi:id="hist_old" name="etat_ancien"/>
        <ownedAttribute xmi:id="hist_new" name="etat_nouveau"/>
        <ownedAttribute xmi:id="hist_source" name="modified_by"/>
        <ownedAttribute xmi:id="hist_raison" name="raison"/>
        <ownedAttribute xmi:id="hist_time" name="timestamp"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="class_optimisation" name="OptimisationService"/>
      <packagedElement xmi:type="uml:Class" xmi:id="class_planning" name="PlanningService"/>
      <packagedElement xmi:type="uml:Class" xmi:id="class_etat_service" name="EtatSalleService"/>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="pkg_usecases" name="CasUtilisation">
      <packagedElement xmi:type="uml:Actor" xmi:id="actor_admin" name="Administrateur"/>
      <packagedElement xmi:type="uml:Actor" xmi:id="actor_user" name="Utilisateur"/>
      <packagedElement xmi:type="uml:Actor" xmi:id="actor_iot" name="Capteur IoT"/>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_auth" name="S'authentifier"/>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_manage_rooms" name="Gerer les salles"/>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_manage_refs" name="Gerer les referentiels"/>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_optimize" name="Lancer l'attribution optimale"/>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_add_schedule" name="Enregistrer un horaire"/>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_view" name="Consulter les salles et plannings"/>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_iot" name="Envoyer l'etat d'occupation"/>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_history" name="Consulter l'historique"/>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="pkg_components" name="Composants">
      <packagedElement xmi:type="uml:Component" xmi:id="comp_admin_ui" name="Interface administration"/>
      <packagedElement xmi:type="uml:Component" xmi:id="comp_public_ui" name="Interface publique"/>
      <packagedElement xmi:type="uml:Component" xmi:id="comp_sim_iot" name="Simulation IoT"/>
      <packagedElement xmi:type="uml:Component" xmi:id="comp_api_salles" name="API Salles"/>
      <packagedElement xmi:type="uml:Component" xmi:id="comp_api_planning" name="API Planning"/>
      <packagedElement xmi:type="uml:Component" xmi:id="comp_api_etat" name="API Etat"/>
      <packagedElement xmi:type="uml:Component" xmi:id="comp_db" name="Base MySQL"/>
      <packagedElement xmi:type="uml:Component" xmi:id="comp_bridge" name="Bridge Python IoT"/>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="pkg_deployment" name="Deploiement">
      <packagedElement xmi:type="uml:Node" xmi:id="node_browser" name="Navigateur utilisateur"/>
      <packagedElement xmi:type="uml:Node" xmi:id="node_xampp" name="Serveur XAMPP"/>
      <packagedElement xmi:type="uml:Node" xmi:id="node_mysql" name="Serveur MySQL"/>
      <packagedElement xmi:type="uml:Node" xmi:id="node_iot" name="Dispositif IoT"/>
      <packagedElement xmi:type="uml:Node" xmi:id="node_bridge" name="Bridge IoT"/>
    </packagedElement>
  </uml:Model>
</xmi:XMI>
